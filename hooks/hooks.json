{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-bash.sh\""}
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {"type": "command", "if": "Read(./.env)", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-read.sh\""},
          {"type": "command", "if": "Read(./.env.*)", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-read.sh\""},
          {"type": "command", "if": "Read(./**/*.pem)", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-read.sh\""},
          {"type": "command", "if": "Read(./**/id_rsa*)", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-read.sh\""}
        ]
      }
    ]
  }
}
